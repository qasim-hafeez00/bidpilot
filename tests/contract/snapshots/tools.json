 "portfolio.search_evidence": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "$defs": {
    "EvidenceFilters": {
     "properties": {
      "outcome": {
       "anyOf": [
        {
         "items": {
          "enum": [
           "won",
           "replied",
           "ignored"
          ],
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "For past proposals only.",
       "title": "Outcome"
      },
      "persona": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Portfolio owner id; defaults to the caller's portfolio.",
       "title": "Persona"
      },
      "since": {
       "anyOf": [
        {
         "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$",
         "type": "string"
        },
        {
