{
 "marketplace.create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "properties": {
    "bid_amount": {
     "exclusiveMinimum": 0,
     "maximum": 100000,
     "title": "Bid Amount",
     "type": "number"
    },
    "bid_type": {
     "enum": [
      "hourly",
      "fixed"
     ],
     "title": "Bid Type",
     "type": "string"
    },
    "cover_letter": {
     "maxLength": 6000,
     "minLength": 20,
     "title": "Cover Letter",
     "type": "string"
    },
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Required. Same key = same effect; a retried call never submits or spends twice.",
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[A-Za-z0-9:_\\-.]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "maxLength": 80,
     "minLength": 3,
     "title": "Job Id",
     "type": "string"
    },
    "screening_answers": {
     "default": [],
     "items": {
      "type": "string"
     },
     "maxItems": 10,
     "title": "Screening Answers",
     "type": "array"
    },
    "trace_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Trace id propagated from the UI request (audit + tracing).",
     "title": "Trace Id"
    }
   },
   "required": [
    "job_id",
    "cover_letter",
    "bid_amount",
    "bid_type",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "connects_cost": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Cost"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotent_replay": {
     "default": false,
     "title": "Idempotent Replay",
     "type": "boolean"
    },
    "marketplace": {
     "title": "Marketplace",
     "type": "string"
    },
    "preview": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Preview"
    },
    "proposal_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Proposal Id"
    },
    "status": {
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "dry_run",
    "status",
    "marketplace"
   ],
   "title": "DraftResult",
   "type": "object"
  }
 },
